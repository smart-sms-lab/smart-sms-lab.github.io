#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/deploy-preview-dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"
cp -R index.html style.css script.js Images BannerV2.png BannerV3.png "$build_dir/"

[[ -d "$build_dir" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}

figma make deploy-preview --build-dir "$build_dir"
